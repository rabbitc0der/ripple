# FalkorDB Configuration
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Application Configuration
APP_ENV=development
PORT=8000
FRONTEND_PORT=5173

# Agent Execution Mode (deterministic | cached | live)
# deterministic: 100% reproducible graph algorithms & receipts, zero API keys required
# cached: replay curated LLM responses for the 4 hero scenarios
# live: call external LLM (requires API keys below)
LLM_MODE=deterministic

# Optional: LLM Providers (Only required if LLM_MODE=live)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
